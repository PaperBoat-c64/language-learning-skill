{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://language-learning-skill.local/schemas/sentence.schema.json",
  "title": "SentenceUnit",
  "description": "One sentence (or line unit) of the source with its aligned translation. The text field must be verbatim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "paragraph", "text", "translation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^s\\d{2,4}-\\d{2,4}$",
      "description": "Absolute position: s<paragraph>-<sentence>, e.g. s01-03."
    },
    "paragraph": {
      "type": "integer",
      "minimum": 1
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "Reading order within the whole document. Optional; array order is authoritative."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Verbatim source text, including punctuation and original glyphs."
    },
    "translation": {
      "type": "string",
      "minLength": 1,
      "description": "Natural translation into the explanation language."
    },
    "literal": {
      "type": ["string", "null"],
      "description": "Optional literal gloss illustrating the construction; never a substitute for translation."
    },
    "registerNote": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vocabularyRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^v\\d{3,4}$"
      }
    },
    "expressionRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^e\\d{3,4}$"
      }
    },
    "grammarRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^g\\d{3,4}$"
      }
    }
  }
}
